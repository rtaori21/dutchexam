# Copy to .env and fill in. .env is gitignored.

# --- LLM backend (choose ONE: ollama | openai | anthropic) ---
# 'ollama'   = fully local, free. Install: brew install ollama; ollama pull llama3.1:8b
# 'openai'   = any OpenAI-compatible API. Recommended: Groq free tier (no card required).
#              Sign up at console.groq.com, get an API key, set OPENAI_BASE_URL below.
# 'anthropic' = Claude API (paid). Best quality.
LLM_BACKEND=ollama

# Ollama (only used if LLM_BACKEND=ollama)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# OpenAI-compatible (Groq is free; defaults below target Groq)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=llama-3.3-70b-versatile

# Anthropic (paid)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Email alerts (Gmail SMTP — use a Google App Password) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_FROM=
ALERT_TO=rahul.taori@tomtom.com

# --- Telegram alerts (much simpler than WhatsApp) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Match threshold for sending alerts (0-100) ---
ALERT_MIN_SCORE=70

# --- Scraper intervals (minutes) ---
SCRAPE_INTERVAL_MINUTES=30
SOURCE_INTERVAL_MINUTES=15

# --- Database ---
# Leave blank to use the auto-computed absolute path (../data/jobs.db relative to repo root).
# DATABASE_URL=

# --- LinkedIn auto-apply (Phase 4 — disabled by default for safety) ---
LINKEDIN_EMAIL=
LINKEDIN_PASSWORD=
AUTO_APPLY_ENABLED=false
